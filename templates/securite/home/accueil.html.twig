<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Aide à la déclaration{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
        <script src="https://kit.fontawesome.com/cb0665c46b.js" crossorigin="anonymous"></script>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100 bg-primary-subtle">
        <a href="#main-content" class="visually-hidden-focusable">Passer au contenu</a>
        <div class="container reload d-flex flex-column flex-grow-1">
            <main class="flex-grow-1 d-flex flex-column justify-content-center" id="main-content" tabindex="-1" role="main">
                <div class="container py-5">
                    <div class="m-3">
                        <h1 class="text-center mb-4">Bienvenue sur votre application de déclaration</h1>
                    </div>
                    <div class="mt-3 row g-4">
                        <div class="col-12 col-md-6 text-center">
                            <a href="{{ path('app_declaration_ir') }}" class="btn btn-primary">Aller voir ma déclaration pour l'impôt sur le revenu</a>
                        </div>
                        <div class="col-12 col-md-6 text-center">
                            <a href="{{ path('app_declaration_ifi') }}" class="btn btn-primary">Aller voir ma déclaration pour l'impôt sur la fortune</a>
                        </div>
                    </div>
                </div>
            </main>
        </div>
        {% block javascripts %}
            <script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </body>
</html>

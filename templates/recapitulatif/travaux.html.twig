{% extends 'base.html.twig' %}

{% block title %}Récapitulatif des travaux{% endblock %}

{% block body %}
<div class="container">
    <h1 class="text-center">Récapitulatif des travaux</h1>
    <form method="post">
        <div class="col-3">
            <label for="choix-anne">Choix année</label>
            <select class="mt-2 form-select" id="choix-annee" name="choix-annee" required>
                <option value="">Choisir une année</option>
                {% for annee in annees %}
                    <option value="{{ annee }}"
                        {% if annee == annee_choisie %} selected {% endif %}>
                    {{ annee }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <button class="mt-2 btn btn-info" type="submit">Choisir</button>
    </form>
    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th scope="col">Type</th>
                <th scope="col">Date</th>
                <th scope="col">Résidence</th>
                <th scope="col">Montant</th>
                <th scope="col">Entreprise</th>
            </tr>
        </thead>
        <tbody>
            {% for travail in travaux %}
                <tr>
                    <td>{{ travail.typeTravaux }}</td>
                    <td>{{ travail.dateTravaux|date('d/m/Y') }}</td>
                    <td>{{ travail.lot.residence.nomResidence }}</td>
                    <td>{{ travail.montantTravaux|number_format(2, ',', ' ') }}</td>
                    <td>{{ travail.entreprise.nomEntreprise }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}

{% extends 'base_IR.html.twig' %}

{% block title %}Travaux{% endblock %}

{% block body %}
    <h1 class="text-center">Créer nouveaux Travaux</h1>

    {{ include('travaux/_form.html.twig') }}

    {% if residence is defined %}
        <button class="mt-3 btn btn-secondary" type="button">
            <a href="{{ path('app_lot_edit', {residenceId: residence.id, id: lot.id }) }}">Retour {{ lot.nomLot }}</a>
        </button>
    {% else %}
        <button class="mt-3 btn btn-secondary" type="button">
            <a href="{{ path('app_ifi_travaux') }}">Retour aux travaux IFI</a>
        </button>
    {% endif %}

    <button class="ms-2 mt-3 btn btn-success" type="button">
        <a href="{{ path('app_entreprise_new') }}">Nouvelle entreprise</a>
    </button>
{% endblock %}

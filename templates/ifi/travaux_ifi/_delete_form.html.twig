<form method="post" action="{{ path('app_ifi_travaux_delete', {'id': travail.id}) }}" onsubmit="return confirm('Etes vous sûr de vouloir supprimer cet élément ? La suppression est définitive.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ travail.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
